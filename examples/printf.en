external printf.
external exit.

// run main with argc as ..., argv as ...:
run main:
    // call printf with "Hello %s\n", "world!";
    call printf with "Hello %s\n", "world!";
    call printf with "int32: %d\n", 1337;
    call printf with "double: %lf\n", 12.34;
    call printf with "Lets push onto the stack! %d %d %d %d %d %d %d %d\n", 1, 2, 3, 4, 5, 6, 7, 8;
    call exit with 42.
